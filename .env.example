# Copy to .env and fill in your Saleor / FilixPay credentials.
# Never commit .env — it is listed in .gitignore.
# All URLs below are placeholders — there are no production defaults in code.

# --- App public URLs (required behind reverse proxy in production) ---
# APP_IFRAME_BASE_URL=https://pay.your-domain.com
# APP_API_BASE_URL=https://pay.your-domain.com
#
# Local Docker Saleor tip:
# APP_IFRAME_BASE_URL=http://localhost:3000
# APP_API_BASE_URL=http://host.docker.internal:3000

# --- FilixPay OpenAPI (server-side only) ---
FILIXPAY_API_BASE_URL=https://your-api-host/openapi/v1
FILIXPAY_TOKEN_URL=https://your-auth-host/realms/your-realm/protocol/openid-connect/token
FILIXPAY_CLIENT_ID=your-filixpay-client-id
FILIXPAY_CLIENT_SECRET=your-filixpay-client-secret
# Payment notify webhook URL is configured in FilixPay Merchant Center, not here.
# Example: https://pay.your-domain.com/api/webhooks/filixpay-notify
# Must match the Webhook Secret in FilixPay Merchant Center exactly.
FILIXPAY_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
# Shared secret for server-to-server recovery APIs:
#   POST /api/private/push-complete  (ops: sync + checkoutComplete)
#   POST /api/private/sync-payment   (storefront refresh: sync only)
# Send as X-FilixPay-Private-Secret or Authorization: Bearer <secret>.
FILIXPAY_PRIVATE_API_SECRET=generate-a-long-random-private-api-secret

# --- APL (Auth Persistence Layer) ---
# Single-server Docker:
# APL=file
# FILE_APL_PATH=/data/.auth-data.json
# APL=upstash  → set UPSTASH_URL / UPSTASH_TOKEN
# APL=saleor-cloud → set REST_APL_TOKEN / REST_APL_ENDPOINT

# --- Optional: DynamoDB APL / mapping storage ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# DYNAMODB_MAIN_TABLE_NAME=

# --- Optional: micselect CMS Deep Pack grant (platform Notify consumer) ---
# Payment App may POST entitlement ingress after CHARGE_SUCCESS; FilixPay core does not.
# MICSELECT_CMS_BASE_URL=https://cms.your-domain.com
# ICHING_ENTITLEMENT_INGRESS_SECRET=shared-with-cms-ingress
# ICHING_DEEP_PACK_REPLAY_SECRET=prefer-dedicated-ops-secret
# ICHING_DEEP_PACK_POLL_ATTEMPTS=5
# ICHING_DEEP_PACK_POLL_BASE_MS=2000
